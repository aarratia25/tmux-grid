#!/usr/bin/env bash
# tmux-grid — open a Ptyxis window with a tmux session split into a 2x2
# grid of shells, all starting in START_DIR.
#
# Usage:
#   tmux-grid              open the default grid (or re-attach to it)
#   tmux-grid NAME         open a SEPARATE grid named NAME (its own window
#                          and tmux session) — run it again to attach
#   tmux-grid ls           list every open grid and how to re-attach
#   tmux-grid add  [NAME]  re-add missing panes back up to a full 2x2 grid
#                          (use after you `exit` a pane by accident)
#   tmux-grid fix  [NAME]  redraw every pane, for a clipped/offset TUI
#   tmux-grid layout [NAME] restore the even 2x2 grid after panes drifted
#   tmux-grid update       git pull the repo this launcher lives in and
#                          re-install, so the machine matches the repo
#                          (the repo is the single source of truth)
#
# Each NAME is an independent tmux session, so you can have several grids
# open at once. Running tmux-grid for an existing NAME re-attaches (nothing
# is duplicated). To start one over: tmux kill-session -t tmux-grid[-NAME]

set -euo pipefail

REPO_URL="https://github.com/aarratia25/tmux-grid"
START_DIR="$HOME/proj"
PANES=4

if ! command -v tmux >/dev/null; then
    echo "tmux-grid: tmux is not installed. Run: sudo apt install tmux" >&2
    exit 1
fi

# First arg may be a subcommand; the remaining arg (if any) names the grid.
cmd=""
case "${1:-}" in
    ls|list)
        # Show every open grid and the exact command to re-attach to it.
        found=""
        for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep -E '^tmux-grid(-|$)'); do
            found="yes"
            case "$s" in
                tmux-grid)   echo "  tmux-grid            (default)" ;;
                tmux-grid-*) echo "  tmux-grid ${s#tmux-grid-}" ;;
            esac
        done
        [ -z "$found" ] && echo "  (no grids open)"
        exit 0
        ;;
    update)
        # Pull the repo this launcher is symlinked into, then re-install, so
        # the running copy always matches the repo — the single source of
        # truth. install.sh symlinks the launcher, so after a pull the change
        # is already live; re-running it also refreshes the desktop entry.
        self="$(readlink -f "$0")"
        repo="$(dirname "$self")"
        if [ ! -d "$repo/.git" ]; then
            echo "tmux-grid: this copy isn't linked to a git checkout — nothing to pull." >&2
            echo "  Clone it and run its install.sh:" >&2
            echo "    git clone $REPO_URL.git" >&2
            echo "    cd tmux-grid && ./install.sh" >&2
            exit 1
        fi
        echo "tmux-grid: pulling latest into $repo …"
        git -C "$repo" pull --ff-only
        "$repo/install.sh"
        exit 0
        ;;
    add|fix|layout) cmd="$1"; shift ;;
esac

if [ -n "${1:-}" ]; then
    SESSION="tmux-grid-$1"
else
    SESSION="tmux-grid"
fi

if [ "$cmd" = "add" ]; then
    # Refill the grid back up to PANES panes and re-tile. Useful after you
    # `exit` a pane by accident: the remaining panes are untouched, only the
    # missing ones are re-created in START_DIR.
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "tmux-grid: no grid '$SESSION' open (start one with: tmux-grid ${1:-})" >&2
        exit 1
    fi
    have=$(tmux list-panes -t "$SESSION:" | wc -l)
    while [ "$have" -lt "$PANES" ]; do
        tmux split-window -t "$SESSION:" -c "$START_DIR"
        tmux select-layout -t "$SESSION:" tiled
        have=$((have + 1))
    done
    echo "tmux-grid: grid refilled to $PANES panes ($SESSION)"
    exit 0
fi

if [ "$cmd" = "layout" ]; then
    tmux select-layout -t "$SESSION:" tiled
    echo "tmux-grid: even grid restored ($SESSION)"
    exit 0
fi

if [ "$cmd" = "fix" ]; then
    # Jiggle each pane's height by 2 rows and back: the size change forces
    # the TUI inside to re-measure and repaint its full frame.
    for p in $(tmux list-panes -t "$SESSION:" -F '#{pane_index}'); do
        tmux resize-pane -t "$SESSION:.$p" -U 2
        tmux resize-pane -t "$SESSION:.$p" -D 2
    done
    echo "tmux-grid: all panes redrawn ($SESSION)"
    exit 0
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -c "$START_DIR"
    for _ in $(seq 2 "$PANES"); do
        tmux split-window -t "$SESSION:" -c "$START_DIR"
        tmux select-layout -t "$SESSION:" tiled
    done
    tmux select-pane -t "$SESSION:.0"

    # Session/window-scoped options only — no global tmux config is touched.
    tmux set-option  -t "$SESSION" status off
    tmux set-option  -t "$SESSION" mouse on
    tmux set-option  -t "$SESSION" set-titles on
    tmux set-option  -t "$SESSION" set-titles-string "#{pane_title} — $SESSION"
    # Pane border shows the pane's current directory (updates as you cd).
    tmux set-option -w -t "$SESSION:" pane-border-status top
    tmux set-option -w -t "$SESSION:" pane-border-format ' #{b:pane_current_path} '
    # Keep the 4 panes equal as you stretch the window: re-tile on resize.
    tmux set-hook -t "$SESSION" client-resized 'select-layout tiled'
fi

# No --maximize: Ptyxis restores the last window size the user set.
# setsid -f detaches the window from whatever launched it, so closing the
# launching terminal (or Ctrl+C) never takes the grid down with it.
setsid -f ptyxis -- tmux attach-session -t "$SESSION" >/dev/null 2>&1
